    family-names: Gresova
    email: gresova11@gmail.com
    # TODO: add `orcid: "https://orcid.org/..."` here. Left out rather than
    # guessed - a wrong ORCID attributes the work to someone else.
repository-code: "https://github.com/genomic-benchmarks/genomic-benchmarks-qc"
url: "https://genomic-benchmarks.github.io/genomic-benchmarks-qc/"
license: MIT
version: "0.9.0"
keywords:
  - genomics
  - machine learning
  - quality control
  - benchmark datasets
  - data leakage
  - bioinformatics
